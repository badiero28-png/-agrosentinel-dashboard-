<script>
  // ── Horloge temps réel
  function updateClock() {
    const now = new Date();
    const pad = n => String(n).padStart(2,'0');
    document.getElementById('clock').textContent =
      `${now.toLocaleDateString('fr-FR', {weekday:'short', day:'2-digit', month:'short'})} · ${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())} UTC`;
  }
  setInterval(updateClock, 1000);
  updateClock();

  // ── Graphique en barres
  const data = [
    { jour: 'Lun', critique: 1, eleve: 2, modere: 1, faible: 0 },
    { jour: 'Mar', critique: 0, eleve: 1, modere: 2, faible: 1 },
    { jour: 'Mer', critique: 2, eleve: 1, modere: 1, faible: 0 },
    { jour: 'Jeu', critique: 1, eleve: 3, modere: 0, faible: 1 },
    { jour: 'Ven', critique: 3, eleve: 2, modere: 2, faible: 0 },
    { jour: 'Sam', critique: 1, eleve: 1, modere: 1, faible: 2 },
    { jour: 'Auj', critique: 2, eleve: 2, modere: 2, faible: 0 },
  ];

  const maxVal = Math.max(...data.map(d => d.critique + d.eleve + d.modere + d.faible));
  const chart = document.getElementById('barChart');

  data.forEach((d, i) => {
    const total = d.critique + d.eleve + d.modere + d.faible;
    const wrap = document.createElement('div');
    wrap.className = 'chart-bar-wrap';

    // Barres empilées
    const stack = document.createElement('div');
    stack.style.cssText = `width:100%;display:flex;flex-direction:column-reverse;height:${Math.max(4,(total/maxVal)*100)}px;border-radius:4px 4px 0 0;overflow:hidden;`;

    const segments = [
      { val: d.critique, color: '#e74c3c' },
      { val: d.eleve,    color: '#e67e22' },
      { val: d.modere,   color: '#f39c12' },
      { val: d.faible,   color: '#2ecc71' },
    ];

    segments.forEach(s => {
      if (s.val > 0) {
        const seg = document.createElement('div');
        seg.style.cssText = `height:${(s.val/total)*100}%;background:${s.color};`;
        stack.appendChild(seg);
      }
    });

    const label = document.createElement('div');
    label.className = 'chart-bar-label';
    label.textContent = d.jour;

    // Valeur totale au-dessus
    const valLabel = document.createElement('div');
    valLabel.style.cssText = `font-family:var(--mono);font-size:9px;color:var(--text2);text-align:center;margin-bottom:3px;`;
    valLabel.textContent = total || '';

    wrap.appendChild(valLabel);
    wrap.appendChild(stack);
    wrap.appendChild(label);
    chart.appendChild(wrap);

    // Animation d'entrée
    wrap.style.opacity = '0';
    wrap.style.transform = 'scaleY(0)';
    wrap.style.transformOrigin = 'bottom';
    wrap.style.transition = `all 0.5s ease ${i * 0.07}s`;
    requestAnimationFrame(() => {
      wrap.style.opacity = '1';
      wrap.style.transform = 'scaleY(1)';
    });
  });

  // ── Simulation live : nouveau signalement toutes les 45s
  const feedList = document.querySelector('.feed-list');
  const nomsAgriculteurs = ['Kofi A.', 'Fatou B.', 'Seydou C.', 'Mariam T.', 'Oumar D.'];
  const zones = ['Tillabéri', 'Dosso', 'Zinder', 'Kayes', 'Ségou'];
  const densites = [2, 3, 4, 3, 2];
  let signalIdx = 0;

  setInterval(() => {
    const nom = nomsAgriculteurs[signalIdx % nomsAgriculteurs.length];
    const zone = zones[signalIdx % zones.length];
    const den = densites[signalIdx % densites.length];

    const item = document.createElement('div');
    item.className = 'feed-item';
    item.style.opacity = '0';
    item.style.transform = 'translateX(-10px)';
    item.style.transition = 'all 0.4s ease';
    item.innerHTML = `
      <div class="feed-avatar">👨‍🌾</div>
      <div class="feed-main">
        <div class="feed-author">${nom} — ${zone}</div>
        <div class="feed-text">Nouveau signalement : activité de criquets observée. Densité ${den}/5.</div>
        <div class="feed-coords">Coords GPS en cours · Densité ${den}/5</div>
      </div>
      <div class="feed-time" style="color:var(--primary)">maintenant</div>
    `;

    feedList.insertBefore(item, feedList.firstChild);
    requestAnimationFrame(() => { item.style.opacity='1'; item.style.transform='translateX(0)'; });

    // Supprimer le 5e item
    const items = feedList.querySelectorAll('.feed-item');
    if (items.length > 4) items[items.length-1].remove();

    signalIdx++;
  }, 45000);

  // ── Simulation : mise à jour compteur alertes
  let alertCount = 3;
  document.querySelectorAll('.nav-badge').forEach(b => b.textContent = alertCount);
</script>
</body>
</html>
