<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AgroSentinel — Dashboard Autorités</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:        #080f0a;
    --bg2:       #0e1a10;
    --bg3:       #142018;
    --surface:   #1a2b1e;
    --border:    #243028;
    --primary:   #2ecc71;
    --primary2:  #27ae60;
    --accent:    #f39c12;
    --danger:    #e74c3c;
    --warn:      #e67e22;
    --safe:      #2ecc71;
    --text:      #e8f5ea;
    --text2:     #8fad96;
    --text3:     #4a6650;
    --mono:      'IBM Plex Mono', monospace;
    --display:   'Syne', sans-serif;
    --body:      'DM Sans', sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--body);
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* ── GRID NOISE TEXTURE */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(46,204,113,.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(46,204,113,.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  /* ── SIDEBAR */
  .sidebar {
    position: fixed;
    left: 0; top: 0; bottom: 0;
    width: 220px;
    background: var(--bg2);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    z-index: 100;
    padding: 0 0 24px 0;
  }

  .sidebar-logo {
    padding: 24px 20px 20px;
    border-bottom: 1px solid var(--border);
  }

  .logo-badge {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo-icon {
    width: 36px; height: 36px;
    background: linear-gradient(135deg, var(--primary), var(--primary2));
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    font-size: 18px;
  }

  .logo-text {
    font-family: var(--display);
    font-size: 16px;
    font-weight: 800;
    letter-spacing: 0.5px;
    color: var(--text);
  }

  .logo-sub {
    font-size: 10px;
    color: var(--text3);
    font-family: var(--mono);
    letter-spacing: 1px;
    margin-top: 2px;
  }

  .sidebar-status {
    margin: 16px 20px;
    padding: 10px 12px;
    background: rgba(46,204,113,.08);
    border: 1px solid rgba(46,204,113,.2);
    border-radius: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .status-dot {
    width: 8px; height: 8px;
    background: var(--primary);
    border-radius: 50%;
    animation: pulse 2s infinite;
    flex-shrink: 0;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }

  .status-text {
    font-size: 11px;
    color: var(--primary);
    font-family: var(--mono);
    font-weight: 600;
  }

  .nav-section {
    padding: 12px 20px 4px;
    font-size: 9px;
    font-family: var(--mono);
    color: var(--text3);
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    cursor: pointer;
    transition: all .2s;
    border-left: 3px solid transparent;
    font-size: 13.5px;
    font-weight: 400;
    color: var(--text2);
  }

  .nav-item:hover { background: var(--surface); color: var(--text); }

  .nav-item.active {
    background: rgba(46,204,113,.08);
    color: var(--primary);
    border-left-color: var(--primary);
    font-weight: 500;
  }

  .nav-icon { font-size: 16px; width: 20px; text-align: center; }

  .nav-badge {
    margin-left: auto;
    background: var(--danger);
    color: white;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 10px;
    font-family: var(--mono);
  }

  .sidebar-footer {
    margin-top: auto;
    padding: 16px 20px;
    border-top: 1px solid var(--border);
  }

  .user-card {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .user-avatar {
    width: 34px; height: 34px;
    background: var(--surface);
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    border: 1px solid var(--border);
  }

  .user-name { font-size: 13px; font-weight: 500; color: var(--text); }
  .user-role { font-size: 10px; color: var(--text3); font-family: var(--mono); }

  /* ── MAIN */
  .main {
    margin-left: 220px;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    z-index: 1;
  }

  /* ── TOPBAR */
  .topbar {
    display: flex;
    align-items: center;
    padding: 16px 28px;
    border-bottom: 1px solid var(--border);
    background: rgba(8,15,10,.8);
    backdrop-filter: blur(10px);
    position: sticky;
    top: 0;
    z-index: 50;
    gap: 16px;
  }

  .topbar-title {
    font-family: var(--display);
    font-size: 18px;
    font-weight: 700;
  }

  .topbar-time {
    margin-left: auto;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--text3);
  }

  .topbar-alert-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 14px;
    background: rgba(231,76,60,.12);
    border: 1px solid rgba(231,76,60,.3);
    border-radius: 8px;
    color: var(--danger);
    font-size: 12px;
    font-weight: 600;
    font-family: var(--mono);
    cursor: pointer;
    animation: border-pulse 2s infinite;
  }

  @keyframes border-pulse {
    0%, 100% { border-color: rgba(231,76,60,.3); }
    50% { border-color: rgba(231,76,60,.8); }
  }

  /* ── CONTENT */
  .content { padding: 24px 28px; flex: 1; }

  /* ── CRITICAL BANNER */
  .critical-banner {
    background: linear-gradient(135deg, rgba(231,76,60,.15), rgba(231,76,60,.05));
    border: 1px solid rgba(231,76,60,.3);
    border-radius: 14px;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 24px;
    position: relative;
    overflow: hidden;
    animation: fadeInDown .5s ease;
  }

  @keyframes fadeInDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .critical-banner::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 4px;
    background: var(--danger);
  }

  .critical-icon {
    font-size: 28px;
    animation: shake 0.5s infinite alternate;
  }

  @keyframes shake {
    from { transform: rotate(-5deg); }
    to { transform: rotate(5deg); }
  }

  .critical-info { flex: 1; }
  .critical-label {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--danger);
    letter-spacing: 2px;
    font-weight: 600;
  }

  .critical-title {
    font-family: var(--display);
    font-size: 17px;
    font-weight: 700;
    margin: 3px 0;
  }

  .critical-sub { font-size: 13px; color: var(--text2); }

  .critical-actions { display: flex; gap: 10px; }

  .btn-danger {
    padding: 8px 16px;
    background: var(--danger);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--body);
    transition: opacity .2s;
  }

  .btn-danger:hover { opacity: 0.85; }

  .btn-outline {
    padding: 8px 16px;
    background: transparent;
    color: var(--text2);
    border: 1px solid var(--border);
    border-radius: 8px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
    font-family: var(--body);
    transition: all .2s;
  }

  .btn-outline:hover { background: var(--surface); color: var(--text); }

  /* ── KPI GRID */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 24px;
  }

  .kpi-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px 20px;
    position: relative;
    overflow: hidden;
    transition: transform .2s, border-color .2s;
    animation: fadeIn .4s ease both;
  }

  .kpi-card:hover { transform: translateY(-2px); border-color: var(--primary); }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .kpi-card:nth-child(1) { animation-delay: .05s; }
  .kpi-card:nth-child(2) { animation-delay: .1s; }
  .kpi-card:nth-child(3) { animation-delay: .15s; }
  .kpi-card:nth-child(4) { animation-delay: .2s; }

  .kpi-glow {
    position: absolute;
    top: 0; right: 0;
    width: 80px; height: 80px;
    border-radius: 50%;
    opacity: 0.08;
    filter: blur(20px);
  }

  .kpi-icon {
    font-size: 22px;
    margin-bottom: 12px;
  }

  .kpi-value {
    font-family: var(--display);
    font-size: 34px;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 4px;
  }

  .kpi-label {
    font-size: 12px;
    color: var(--text2);
    font-weight: 400;
  }

  .kpi-trend {
    position: absolute;
    top: 18px; right: 18px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 3px;
  }

  .trend-up { color: var(--danger); }
  .trend-down { color: var(--safe); }

  /* ── MAIN GRID */
  .main-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  .card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }

  .card-header {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
    gap: 10px;
  }

  .card-title {
    font-family: var(--display);
    font-size: 14px;
    font-weight: 700;
    flex: 1;
  }

  .card-tag {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text3);
    background: var(--bg3);
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 1px;
  }

  /* ── MAP PLACEHOLDER */
  .map-container {
    height: 340px;
    background: var(--bg3);
    position: relative;
    overflow: hidden;
  }

  .map-svg {
    width: 100%; height: 100%;
  }

  .map-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 60% 40%, transparent 40%, var(--bg3) 100%);
  }

  /* Points sur la carte */
  .map-point {
    position: absolute;
    transform: translate(-50%, -50%);
    cursor: pointer;
  }

  .map-point-ring {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 2px solid currentColor;
    animation: ring-expand 2s infinite;
  }

  @keyframes ring-expand {
    0% { width: 16px; height: 16px; opacity: .8; }
    100% { width: 48px; height: 48px; opacity: 0; }
  }

  .map-dot {
    width: 14px; height: 14px;
    border-radius: 50%;
    border: 2px solid white;
    position: relative;
    z-index: 2;
    transition: transform .2s;
  }

  .map-dot:hover { transform: scale(1.4); }

  .map-label {
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    font-family: var(--mono);
    font-size: 9px;
    font-weight: 600;
    white-space: nowrap;
    background: var(--bg);
    padding: 2px 6px;
    border-radius: 4px;
    pointer-events: none;
  }

  .map-legend {
    position: absolute;
    bottom: 12px; right: 12px;
    background: rgba(8,15,10,.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px 14px;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 10px;
    color: var(--text2);
    margin-bottom: 5px;
    font-family: var(--mono);
  }

  .legend-item:last-child { margin-bottom: 0; }

  .legend-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .map-stats {
    position: absolute;
    top: 12px; left: 12px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .map-stat-pill {
    background: rgba(8,15,10,.85);
    backdrop-filter: blur(8px);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 5px 12px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--text2);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* ── ALERTES TABLE */
  .alert-list { padding: 0; }

  .alert-row {
    display: flex;
    align-items: center;
    padding: 13px 20px;
    border-bottom: 1px solid var(--border);
    gap: 12px;
    transition: background .15s;
    cursor: pointer;
  }

  .alert-row:last-child { border-bottom: none; }
  .alert-row:hover { background: var(--surface); }

  .alert-level {
    width: 10px; height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .alert-main { flex: 1; min-width: 0; }
  .alert-zone {
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .alert-meta {
    font-size: 11px;
    color: var(--text2);
    font-family: var(--mono);
    margin-top: 2px;
  }

  .alert-badge {
    font-family: var(--mono);
    font-size: 10px;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 6px;
    letter-spacing: 0.8px;
    flex-shrink: 0;
  }

  .badge-critique {
    background: rgba(231,76,60,.15);
    color: var(--danger);
    border: 1px solid rgba(231,76,60,.3);
  }

  .badge-eleve {
    background: rgba(230,126,34,.15);
    color: var(--warn);
    border: 1px solid rgba(230,126,34,.3);
  }

  .badge-modere {
    background: rgba(243,156,18,.15);
    color: var(--accent);
    border: 1px solid rgba(243,156,18,.3);
  }

  .badge-faible {
    background: rgba(46,204,113,.15);
    color: var(--safe);
    border: 1px solid rgba(46,204,113,.3);
  }

  .alert-time {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text3);
    flex-shrink: 0;
  }

  /* ── BOTTOM GRID */
  .bottom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1.2fr;
    gap: 20px;
    margin-bottom: 20px;
  }

  /* ── CHART */
  .chart-area {
    padding: 20px;
  }

  .chart-bars {
    display: flex;
    align-items: flex-end;
    gap: 6px;
    height: 120px;
    margin-bottom: 8px;
  }

  .chart-bar-wrap {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    height: 100%;
    justify-content: flex-end;
  }

  .chart-bar {
    width: 100%;
    border-radius: 4px 4px 0 0;
    transition: opacity .2s;
    cursor: pointer;
  }

  .chart-bar:hover { opacity: 0.75; }

  .chart-bar-label {
    font-family: var(--mono);
    font-size: 9px;
    color: var(--text3);
    text-align: center;
  }

  .chart-legend {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .chart-leg-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
    color: var(--text2);
    font-family: var(--mono);
  }

  .chart-leg-dot {
    width: 8px; height: 8px;
    border-radius: 2px;
  }

  /* ── COUNTRIES */
  .country-list { padding: 8px 0; }

  .country-row {
    display: flex;
    align-items: center;
    padding: 10px 20px;
    gap: 12px;
    transition: background .15s;
  }

  .country-row:hover { background: var(--surface); }

  .country-flag { font-size: 20px; }

  .country-info { flex: 1; }
  .country-name { font-size: 13px; font-weight: 500; }
  .country-zones { font-size: 11px; color: var(--text2); font-family: var(--mono); }

  .country-bar-wrap { width: 80px; }

  .country-bar-bg {
    height: 5px;
    background: var(--bg3);
    border-radius: 3px;
    overflow: hidden;
  }

  .country-bar-fill {
    height: 100%;
    border-radius: 3px;
    transition: width .6s ease;
  }

  .country-risk {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 700;
    width: 28px;
    text-align: right;
  }

  /* ── SIGNALEMENTS */
  .feed-list { padding: 0; }

  .feed-item {
    display: flex;
    gap: 12px;
    padding: 13px 20px;
    border-bottom: 1px solid var(--border);
    transition: background .15s;
  }

  .feed-item:last-child { border-bottom: none; }
  .feed-item:hover { background: var(--surface); }

  .feed-avatar {
    width: 32px; height: 32px;
    border-radius: 8px;
    background: var(--surface);
    display: flex; align-items: center; justify-content: center;
    font-size: 15px;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }

  .feed-main { flex: 1; min-width: 0; }
  .feed-author { font-size: 12px; font-weight: 600; }
  .feed-text { font-size: 12px; color: var(--text2); margin-top: 2px; line-height: 1.4; }
  .feed-coords {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text3);
    margin-top: 4px;
  }

  .feed-time {
    font-family: var(--mono);
    font-size: 10px;
    color: var(--text3);
    flex-shrink: 0;
  }

  /* ── STATS ROW */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 20px;
  }

  .mini-stat {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 14px;
    animation: fadeIn .5s ease both;
  }

  .mini-stat:nth-child(1) { animation-delay: .3s; }
  .mini-stat:nth-child(2) { animation-delay: .35s; }
  .mini-stat:nth-child(3) { animation-delay: .4s; }

  .mini-stat-icon {
    width: 44px; height: 44px;
    border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }

  .mini-stat-val {
    font-family: var(--display);
    font-size: 26px;
    font-weight: 800;
    line-height: 1;
  }

  .mini-stat-label {
    font-size: 12px;
    color: var(--text2);
    margin-top: 2px;
  }

  /* ── SCROLLBAR */
  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

  /* ── TOOLTIP */
  [data-tip] { position: relative; }
  [data-tip]:hover::after {
    content: attr(data-tip);
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 11px;
    padding: 5px 10px;
    border-radius: 6px;
    white-space: nowrap;
    font-family: var(--mono);
    z-index: 999;
  }

  /* ── RESPONSIVE */
  @media (max-width: 1100px) {
    .kpi-grid { grid-template-columns: repeat(2, 1fr); }
    .main-grid { grid-template-columns: 1fr; }
    .bottom-grid { grid-template-columns: 1fr 1fr; }
    .stats-row { grid-template-columns: 1fr 1fr; }
  }
</style>
</head>
<body>

<!-- ═══════════════════════════════════ SIDEBAR -->
<aside class="sidebar">
  <div class="sidebar-logo">
    <div class="logo-badge">
      <div class="logo-icon">🌿</div>
      <div>
        <div class="logo-text">AgroSentinel</div>
        <div class="logo-sub">DASHBOARD v1.0</div>
      </div>
    </div>
  </div>

  <div class="sidebar-status">
    <div class="status-dot"></div>
    <div class="status-text">SYSTÈME ACTIF</div>
  </div>

